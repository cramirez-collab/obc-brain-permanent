# ObjetivaAR — environment variables
#
# Copy to .env (gitignored) or set these in the Manus / hosting secret
# manager. NEVER commit real values. Rotate any credential that was ever
# committed (the original .project-config.json leaked live secrets).

# --- Database (TiDB / MySQL) ---
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DB?ssl={\"rejectUnauthorized\":true}"

# --- Auth ---
JWT_SECRET="change-me"
OAUTH_SERVER_URL="https://api.manus.im"
OWNER_NAME=""
OWNER_OPEN_ID=""

# --- Autodesk APS / Forge (RVT/IFC -> GLB conversion) ---
APS_CLIENT_ID=""
APS_CLIENT_SECRET=""
BUILT_IN_FORGE_API_KEY=""
BUILT_IN_FORGE_API_URL="https://forge.manus.ai"

# --- Frontend (Vite, exposed to the browser — no secrets here) ---
VITE_APP_ID=""
VITE_APP_TITLE="ObjetivaAR"
VITE_APP_LOGO=""
VITE_OAUTH_PORTAL_URL="https://manus.im"
VITE_FRONTEND_FORGE_API_KEY=""
VITE_FRONTEND_FORGE_API_URL="https://forge.manus.ai"
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
