# ============================================================
#  Mi Memoria · Backend de WhatsApp — variables de entorno
#  Copia este archivo a ".env" y rellena tus valores.
# ============================================================

# Puerto del servidor
PORT=3000

# Clave secreta que la app web manda en el header X-Api-Key (invéntala, larga)
API_KEY=cambia-esta-clave-por-una-larga-y-secreta

# Origen permitido (CORS). Tu sitio. Usa * solo para pruebas.
ALLOW_ORIGIN=https://cramirez-collab.github.io

# A quién enviar si un recordatorio no trae número (tu WhatsApp, solo dígitos con país)
DEFAULT_TO=5215555555555

# Proveedor: "meta" (WhatsApp Cloud API) o "twilio"
PROVIDER=meta

# ---------- Opción A: WhatsApp Cloud API (Meta) ----------
# https://developers.facebook.com → app → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAG...tu_token_permanente
WHATSAPP_PHONE_ID=123456789012345
# Para mensajes programados (fuera de la ventana de 24h) DEBES usar una plantilla aprobada.
# Crea una plantilla de categoría "Utility" con UN parámetro de cuerpo {{1}} y pon su nombre aquí.
# Si dejas WHATSAPP_TEMPLATE vacío, se envía texto plano (solo funciona dentro de 24h de la última conversación).
WHATSAPP_TEMPLATE=recordatorio
WHATSAPP_TEMPLATE_LANG=es_MX

# ---------- Opción B: Twilio ----------
TWILIO_SID=ACxxxxxxxxxxxxxxxx
TWILIO_TOKEN=tu_auth_token
# Número de WhatsApp de Twilio (con +). Sandbox: +14155238886
TWILIO_FROM=+14155238886
